{
  // The build config covers `src` only, which leaves the editor to guess at a
  // project for these files -- and guess wrong, since it neither loads
  // @types/node nor knows the module settings. This config exists purely so
  // the language server has something to attach them to; nothing emits.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Override the build config's `src`, which these files sit outside of.
    "rootDir": ".",
    "allowJs": true,
    // The fixtures are deliberately loose plain JS, so don't type-check them.
    "checkJs": false
  },
  "include": ["."]
}
