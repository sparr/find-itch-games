{
  "name": "find-itch-games",
  "version": "0.1.0",
  "description": "Find the itch.io app, its install locations, and installed itch.io games on disk",
  "keywords": [
    "itch",
    "itch.io",
    "butler",
    "games",
    "search",
    "install",
    "library"
  ],
  "license": "MIT",
  "author": "Clarence \"Sparr\" Risher <sparr0@gmail.com>",
  "homepage": "https://sparr.github.io/find-itch-games/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sparr/find-itch-games.git"
  },
  "bugs": {
    "url": "https://github.com/sparr/find-itch-games/issues"
  },
  "type": "module",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "build": "node scripts/build.mjs",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "docs": "typedoc",
    "docs:md": "typedoc --options typedoc.markdown.json",
    "version:check": "node scripts/check-versions.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "publish:npm": "npm publish",
    "publish:github": "node scripts/publish-github.mjs",
    "publish:jsr": "npx jsr publish",
    "prepublishOnly": "npm run version:check && npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.6.0"
  }
}
